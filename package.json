{
  "name": "flotilla-budabit",
  "version": "1.6.2",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm run dev:full",
    "dev:app": "vite dev",
    "dev:workspace": "vite dev",
    "dev:full": "node scripts/check-dev-port.mjs && pnpm --filter @nostr-git/core --filter @nostr-git/ui run build && pnpm --include-workspace-root --parallel --stream --filter flotilla-budabit --filter @nostr-git/core --filter @nostr-git/ui run dev:workspace",
    "deploy:main": "./scripts/deploy-main.sh",
    "deploy:main:built": "BUDABIT_SKIP_BUILD=1 ./scripts/deploy-main.sh",
    "deploy:test": "./scripts/deploy-test.sh",
    "deploy:test:built": "BUDABIT_SKIP_BUILD=1 ./scripts/deploy-test.sh",
    "screenshots:landing": "node scripts/capture-landing-screenshots.mjs",
    "build": "./build.sh",
    "build:extensions": "pnpm --filter './packages/flotilla-extension-template/packages/*' --filter './packages/budabit-pipelines-extension/packages/*' --filter './packages/budabit-releases-extension/packages/*' run build",
    "dev:releases": "pnpm --filter budabit-sdk run build && pnpm --parallel --stream --filter budabit-sdk --filter @budabit-releases-extension/iframe run dev:workspace",
    "dev:pipelines": "pnpm --filter budabit-sdk run build && pnpm --parallel --stream --filter budabit-sdk --filter @flotilla/ext-iframe run dev:workspace",
    "dev:template": "pnpm --filter @budabit/ext-shared run build && pnpm --parallel --stream --filter @budabit/ext-shared --filter @budabit/ext-iframe run dev:workspace",
    "serve": "vite serve",
    "build-in-production": "./build-in-production.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
    "check:extensions": "pnpm --filter './packages/flotilla-extension-template/packages/*' --filter './packages/budabit-pipelines-extension/packages/*' --filter './packages/budabit-releases-extension/packages/*' run typecheck",
    "check:deploy-cache": "node scripts/check-deploy-cache.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
    "lint": "prettier --check \"src/**/*.{ts,js,css}\" && eslint src",
    "format": "git diff head --name-only --diff-filter d | grep -E '(js|ts|css)$' | xargs -r prettier --write",
    "format:all": "prettier --write \"src/**/*.{ts,js,css}\"",
    "discover:relay-defaults": "node scripts/discover-relay-defaults.mjs",
    "probe:public-relay": "node scripts/probe-public-relay.mjs",
    "prepare": "husky",
    "test": "vitest run --coverage",
    "test:main": "vitest run --coverage --project=main",
    "test:welshman": "pnpm --filter @welshman test",
    "test:extensions": "vitest run --project=budabit-releases-extension --project=budabit-pipelines-extension --project=flotilla-extension-template --project=budabit-sdk",
    "test:releases": "vitest run --project=budabit-releases-extension",
    "test:nostr-git-core": "vitest run --coverage -c packages/nostr-git-core/vitest.config.ts",
    "test:nostr-git-ui": "vitest run --coverage -c packages/nostr-git-ui/vitest.config.ts",
    "test:repo": "vitest run -c packages/nostr-git-ui/tests/vitest.config.ts",
    "test:ui": "vitest --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:check": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright test --project=setup",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:identity": "playwright test --project=identity",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:widget": "playwright test --project=widget",
    "test:e2e:ui": "playwright test --ui",
    "test:atomic:unit": "vitest run --project=main src/app/core/app-update.test.ts tests/static-deploy.test.ts tests/deploy-cache-check.test.ts",
    "test:atomic:e2e": "playwright test --config=playwright.atomic.config.ts",
    "test:atomic": "pnpm test:atomic:unit && pnpm test:atomic:e2e",
    "perf:roots": "playwright test --config=playwright.performance.config.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.50.0",
    "@sveltejs/kit": "^2.46.5",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/eslint": "^9.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.10.1",
    "@types/throttle-debounce": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "5.39.12",
    "svelte-check": "4.3.3",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "5.4.20",
    "vitest": "^3.2.4",
    "zod": "3.25.76"
  },
  "type": "module",
  "dependencies": {
    "@cashu/cashu-ts": "5.0.0-rc.4",
    "@cashu/coco-core": "2.0.0",
    "@cashu/coco-indexeddb": "2.0.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@getalby/lightning-tools": "^6.0.0",
    "@getalby/sdk": "^5.1.2",
    "@lucide/svelte": "^0.482.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.1",
    "@nostr-git/core": "workspace:*",
    "@nostr-git/ui": "workspace:*",
    "@octokit/auth-oauth-device": "^8.0.1",
    "@pomade/core": "^0.2.1",
    "@poppanator/sveltekit-svg": "^4.2.1",
    "@scure/bip39": "^1.2.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@tiptap/core": "^2.27.1",
    "@types/qrcode": "^1.5.5",
    "@types/throttle-debounce": "^5.0.2",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@welshman/app": "workspace:*",
    "@welshman/content": "workspace:*",
    "@welshman/editor": "workspace:*",
    "@welshman/feeds": "workspace:*",
    "@welshman/lib": "workspace:*",
    "@welshman/net": "workspace:*",
    "@welshman/router": "workspace:*",
    "@welshman/signer": "workspace:*",
    "@welshman/store": "workspace:*",
    "@welshman/util": "workspace:*",
    "comlink": "^4.4.2",
    "compressorjs": "^1.2.1",
    "daisyui": "^4.12.24",
    "date-fns": "^4.1.0",
    "date-picker-svelte": "^2.16.0",
    "dompurify": "^3.3.0",
    "dotenv": "^16.6.1",
    "emoji-picker-element": "^1.27.0",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "isomorphic-git": "^1.36.1",
    "markdown-it": "^14.1.0",
    "marked": "^17.0.0",
    "mustache": "^4.2.0",
    "nostr-tools": "^2.19.4",
    "polyfill-crypto-methods": "^1.0.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.1",
    "throttle-debounce": "^5.0.2",
    "tippy.js": "^6.3.7"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "2.27.1",
      "@tiptap/pm": "2.27.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "patchedDependencies": {
      "@cashu/coco-indexeddb@2.0.0": "patches/@cashu__coco-indexeddb@2.0.0.patch",
      "@cashu/coco-core@2.0.0": "patches/@cashu__coco-core@2.0.0.patch",
      "isomorphic-git@1.37.2": "patches/isomorphic-git@1.37.2.patch"
    }
  }
}
