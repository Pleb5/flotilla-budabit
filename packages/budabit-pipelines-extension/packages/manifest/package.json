{
  "name": "@flotilla/ext-manifest",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/generator.js",
  "types": "./dist/generator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "generate": "budabit-generate",
    "publish-widget": "budabit-publish"
  },
  "dependencies": {
    "budabit-sdk": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
